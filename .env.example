# Sao chép file này thành .env (chạy máy nhà) hoặc nhập từng dòng vào Environment trên Render.
# KHÔNG đưa file .env có khóa thật lên GitHub.

# --- Claude (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- KiotViet (giống MCP server hiện tại) ---
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=

# --- Telegram (tạo bot với @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=dat-mot-chuoi-bi-mat-bat-ky

# --- Facebook Page (developers.facebook.com) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_APP_SECRET=
FB_VERIFY_TOKEN=annhung-verify

# --- Zalo OA (developers.zalo.me) ---
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_OA_SECRET_KEY=
ZALO_ACCESS_TOKEN=
ZALO_REFRESH_TOKEN=

# --- Lịch đăng bài ---
TIMEZONE=Asia/Ho_Chi_Minh
DANG_BAI_GIO=8
DANG_BAI_PHUT=0

# Thư mục lưu dữ liệu (trên Render nên trỏ vào Persistent Disk, VD /var/data)
DATA_DIR=
